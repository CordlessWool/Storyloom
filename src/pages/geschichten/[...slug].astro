---
import GeschichtenLayout from '../../layouts/GeschichtenLayout.astro';
import PostArticle from '../../components/PostArticle.astro';
import { BLOGS, adjacent, getPosts } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts('geschichten');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, ...adjacent(posts, post.id) } }));
}

const blog = BLOGS.geschichten;
const { post, newer, older } = Astro.props;
---

<GeschichtenLayout title={post.data.title} description={post.data.excerpt}>
  <PostArticle post={post} blog={blog.key} newer={newer} older={older} showCover={false} olderLabel="Vorherige Geschichte" newerLabel="Nächste Geschichte" />
</GeschichtenLayout>
