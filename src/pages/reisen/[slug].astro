---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostArticle from '../../components/PostArticle.astro';
import { BLOGS, adjacent, getPosts, imageSrc } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts('reisen');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, ...adjacent(posts, post.id) } }));
}

const blog = BLOGS.reisen;
const { post, newer, older } = Astro.props;
---

<BaseLayout title={post.data.title} description={post.data.excerpt} image={imageSrc(post.data.cover)} blog={blog.key}>
  <PostArticle post={post} blog={blog.key} newer={newer} older={older} />
</BaseLayout>
