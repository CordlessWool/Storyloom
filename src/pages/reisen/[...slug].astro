---
import ReisenLayout from '../../layouts/ReisenLayout.astro';
import PostArticle from '../../components/PostArticle.astro';
import { BLOGS, getPosts, url } from '../../lib/site';
import { dayOf, groupTrips } from '../../lib/trips';

export async function getStaticPaths() {
  const trips = groupTrips(await getPosts('reisen'));
  // Previous/next day within the same trip, not across trips.
  return trips.flatMap((trip) =>
    trip.posts.map((post, i) => ({
      params: { slug: post.id },
      props: { post, trip, older: trip.posts[i - 1], newer: trip.posts[i + 1] },
    })),
  );
}

const blog = BLOGS.reisen;
const { post, trip, older, newer } = Astro.props;
---

<ReisenLayout title={post.data.title} description={post.data.excerpt} image={post.data.cover}>
  <PostArticle post={post} blog={blog.key} newer={newer} older={older} olderLabel="Vorige Etappe" newerLabel="Nächste Etappe" heroCover>
    <a slot="kicker" class="day-badge" href={url(`/reisen/${trip.key}/`)} title={`Alle Etappen: ${trip.name}`}>
      <span class="day-badge-trip">{trip.name}</span>
      <span class="day-badge-day mono">Tag {String(dayOf(trip, post)).padStart(2, '0')}</span>
    </a>
  </PostArticle>
</ReisenLayout>
