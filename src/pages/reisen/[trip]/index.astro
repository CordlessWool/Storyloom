---
import CoverImage from '../../../components/CoverImage.astro';
import ReisenLayout from '../../../layouts/ReisenLayout.astro';
import TripTimeline from '../../../components/TripTimeline.astro';
import { BLOGS, getPosts, url } from '../../../lib/site';
import { dayOf, groupTrips, tripCover, tripPeriod } from '../../../lib/trips';

export async function getStaticPaths() {
  const trips = groupTrips(await getPosts('reisen'));
  return trips.map((trip) => ({ params: { trip: trip.key }, props: { trip } }));
}

const blog = BLOGS.reisen;
const { trip } = Astro.props;
const cover = tripCover(trip);
const days = dayOf(trip, trip.posts.at(-1)!);
---

<ReisenLayout title={`${trip.name} · ${blog.title}`} description={`${blog.title}: ${trip.name}, ${tripPeriod(trip)}`} image={cover}>
  <div class="reisen-front">
    <header class="front-head" data-ressort="reisen">
      <p class="front-stat mono"><a href={url('/reisen/')}>← Alle Reisen</a></p>
      <h1><span class="dot" aria-hidden="true"></span>{trip.name}</h1>
      <p class="front-tagline">{tripPeriod(trip)}</p>
      <p class="front-stat mono">{trip.posts.length} Etappen in {days} Tagen</p>
    </header>
    {cover && (
      <figure class="ring ring--front" aria-hidden="true">
        <CoverImage src={cover} alt="" widths={[320, 640]} sizes="17rem" loading="eager" />
      </figure>
    )}
  </div>

  <TripTimeline trip={trip} showHead={false} />
</ReisenLayout>
