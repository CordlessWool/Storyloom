---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { BLOGS, getPosts, groupByTrip, tripTitle, url } from '../../lib/site';

const blog = BLOGS.reisen;
const trips = groupByTrip(await getPosts(blog.key));
---

<BaseLayout title={blog.title} description={blog.description} blog={blog.key}>
  <header class="blog-header">
    <h1>{blog.title}</h1>
    <p>{blog.tagline}</p>
  </header>
  {trips.map(({ trip, posts }) => (
    <section class="trip">
      <h2><a href={url(`/reisen/${trip}/`)}>{tripTitle(trip)}</a></h2>
      <PostList posts={posts} blog={blog.key} />
    </section>
  ))}
</BaseLayout>
