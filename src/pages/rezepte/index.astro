---
import RezepteLayout from '../../layouts/RezepteLayout.astro';
import BlogFront from '../../components/BlogFront.astro';
import RecipeSearch from '../../components/rezepte/RecipeSearch.astro';
import RecipeGrid from '../../components/rezepte/RecipeGrid.astro';
import { BLOGS, getPosts } from '../../lib/site';

const blog = BLOGS.rezepte;
const posts = await getPosts(blog.key);
---

<RezepteLayout title={blog.title} description={blog.description}>
  <div class="recipes-head">
    <BlogFront blog={blog} count={posts.length} stat="" />
    <RecipeSearch posts={posts} />
  </div>
  <RecipeGrid posts={posts} />
</RezepteLayout>
