---
import RezepteLayout from '../../layouts/RezepteLayout.astro';
import RecipeArticle from '../../components/rezepte/RecipeArticle.astro';
import { render } from 'astro:content';
import { adjacent, getPosts } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts('rezepte');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, ...adjacent(posts, post.id) } }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<RezepteLayout title={post.data.title} description={post.data.excerpt} image={post.data.cover} post={post}>
  <RecipeArticle post={post} newer={newer} older={older}>
    <Content />
  </RecipeArticle>
</RezepteLayout>
