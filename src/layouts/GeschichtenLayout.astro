---
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import '../styles/geschichten.css';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
}
const { title, description, image } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} blog="geschichten">
  <slot />
</BaseLayout>
