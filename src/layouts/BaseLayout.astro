---
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ogImageUrl } from '../lib/cover';
import { SITE, url, type BlogKey } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  blog?: BlogKey;
}

const { title, description = SITE.description, image, blog } = Astro.props;
const pageTitle = title ? `${title} – ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? await ogImageUrl(image, Astro.site!) : undefined;
---

<!doctype html>
<html lang={SITE.lang} data-blog={blog}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="google-site-verification" content="MwdQnALvlvJWCwLvaxVHbzYztNc32H2DxHg3Di-WZf0" />
    <script is:inline>
      // Theme before first paint: saved choice, otherwise the system setting.
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    {import.meta.env.PROD && (
      <script is:inline defer src="https://umami.dropanote.de/script.js" data-website-id="86598dec-a37b-4f4f-b0b5-b762bcbee549"></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <Header current={blog} />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
