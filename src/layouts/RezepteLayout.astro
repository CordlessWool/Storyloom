---
import type { ImageMetadata } from 'astro';
import type { Post } from '../lib/site';
// Rezepte boundary: this layout, styles/rezepte.css, components/rezepte/* and
// pages/rezepte/* are the only recipe-specific files.
import BaseLayout from './BaseLayout.astro';
import '../styles/rezepte.css';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  /** The post shown on this page, for article metadata. */
  post?: Post;
}
---

<BaseLayout {...Astro.props} blog="rezepte">
  <slot />
</BaseLayout>
