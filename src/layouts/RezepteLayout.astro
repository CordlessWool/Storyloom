---
import type { ImageMetadata } from 'astro';
// Rezepte boundary: this layout, styles/rezepte.css, components/rezepte/* and
// pages/rezepte/* are the only recipe-specific files.
import BaseLayout from './BaseLayout.astro';
import '../styles/rezepte.css';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
}
const { title, description, image } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} blog="rezepte">
  <slot />
</BaseLayout>
