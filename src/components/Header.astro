---
import { BLOG_LIST, SITE, url, type BlogKey } from '../lib/site';

interface Props {
  current?: BlogKey;
}
const { current } = Astro.props;
---

<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href={url('/')}>
      <span class="brand-mark" aria-hidden="true"></span>
      {SITE.title}
    </a>
    <nav class="tabs" aria-label="Teile des Notizbuchs">
      {BLOG_LIST.map((b) => (
        <a href={url(`/${b.key}/`)} data-ressort={b.key} aria-current={b.key === current ? 'page' : undefined}>
          <span class="dot" aria-hidden="true"></span>
          {b.title}
        </a>
      ))}
    </nav>
    <button class="theme-toggle" type="button" aria-label="Dunkles Farbschema" aria-pressed="false">
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </button>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.querySelector('.theme-toggle');
    const sync = () => button.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
    sync();
    button.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', root.dataset.theme);
      } catch {}
      sync();
    });
  })();
</script>
