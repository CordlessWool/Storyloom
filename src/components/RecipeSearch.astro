---
import { url } from '../lib/site';
// Pagefind's index is generated after `astro build`, so search only works in
// `npm run build && npm run preview`, not in `astro dev`.
const bundle = url('/pagefind/');
---

<link rel="stylesheet" href={`${bundle}pagefind-ui.css`} />
<div id="recipe-search" class="recipe-search" data-bundle={bundle}></div>
<script is:inline>
  (() => {
    const el = document.getElementById('recipe-search');
    const bundle = el.dataset.bundle;
    const script = document.createElement('script');
    script.src = `${bundle}pagefind-ui.js`;
    script.onload = () =>
      new PagefindUI({
        element: '#recipe-search',
        bundlePath: bundle,
        showSubResults: true,
        showImages: true,
        resetStyles: false,
        translations: {
          placeholder: 'Rezepte durchsuchen …',
          zero_results: 'Kein Rezept für „[SEARCH_TERM]“ gefunden',
        },
      });
    script.onerror = () => {
      el.textContent = 'Die Suche ist erst nach „npm run build“ verfügbar.';
    };
    document.head.append(script);
  })();
</script>
