---
import { ICON_PATHS, type IconKind } from './recipe-icons';

interface Props {
  kind: IconKind;
  class?: string;
}
const { kind, class: cls } = Astro.props;
---

<svg class:list={['recipe-icon', cls]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={ICON_PATHS[kind]} />
</svg>
