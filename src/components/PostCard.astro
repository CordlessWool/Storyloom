---
import CoverImage from './CoverImage.astro';
import { formatDate, postUrl, type BlogKey, type Post } from '../lib/site';

interface Props {
  post: Post;
  blog: BlogKey;
}
const { post, blog } = Astro.props;
const { title, date, excerpt, cover, coverAlt } = post.data;
---

<article class="post-card">
  {cover && <CoverImage src={cover} alt={coverAlt ?? ''} widths={[400, 800, 1200]} sizes="(min-width: 42rem) 42rem, 100vw" />}
  <div>
    <h2><a href={postUrl(blog, post.id)}>{title}</a></h2>
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {excerpt && <p>{excerpt}</p>}
  </div>
</article>
