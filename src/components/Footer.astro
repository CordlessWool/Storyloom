---
import { SITE, url } from '../lib/site';
---

<footer class="footer">
  <div class="wrap footer-inner">
    <p class="footer-brand">
      <img class="brand-mark" src={url('/favicon.svg')} alt="" width="26" height="26" />
      {SITE.title}
      <span class="footer-claim">{SITE.description}</span>
    </p>
    <nav aria-label="Weiteres">
      <a href={url('/hintergrund/')}>Über den Autor</a>
      <a href={url('/impressum/')}>Impressum</a>
      <a href={url('/rss.xml')}>RSS</a>
      <a href={SITE.support.url} rel="noopener">{SITE.support.label}</a>
    </nav>
  </div>
</footer>
