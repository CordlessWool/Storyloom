// Static site on Cloudflare Workers. Cloudflare builds it on every push
// (Workers Builds: build command `bun run build`, deploy command `bunx wrangler deploy`).
{
  "name": "storyloom",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
